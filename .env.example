# Copiar este archivo como .env y completar los valores

# Contraseña de acceso a la aplicación
APP_PASSWORD=campo123

# URL de la base de datos (SQLite local por defecto, Railway setea esto automáticamente)
DATABASE_URL=sqlite:///campo.db

# API Key de OpenAI (obtener en https://platform.openai.com/api-keys)
OPENAI_API_KEY=tu_clave_aqui
# Modelo a usar (opcional, por defecto gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini
